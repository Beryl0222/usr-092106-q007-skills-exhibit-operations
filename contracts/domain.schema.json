{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "技能展项运行台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CONTENT_APPROVED",
        "SLOT_ASSIGNED",
        "SESSION_RECORDED",
        "FAULT_REPORTED",
        "EXHIBIT_RELEASED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "exhibit_version",
        "visit_session",
        "queue_slot",
        "maintenance_order"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
